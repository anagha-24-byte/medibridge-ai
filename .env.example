# ==============================================================================
# MediBridge AI - Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# Node Environment (development | production)
NODE_ENV=development

# Google Gemini API Key for Health Assistant & Vision Analysis
# Obtain from: https://aistudio.google.com/
# Leave empty to run in honest unconfigured mode with setup instructions
GEMINI_API_KEY=

# Server Session / JWT Secret (used to sign authentication tokens)
JWT_SECRET=medibridge_super_secret_session_key_2026_change_in_prod

# Optional SMS / OTP Provider Credentials (e.g. Twilio / MSG91)
SMS_PROVIDER_NAME=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Hospital Search & Geocoding Service Configuration
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
